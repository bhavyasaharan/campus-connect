# ==========================================
# Root .gitignore for CampusConnect Monorepo
# ==========================================

# OS & IDE Files
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
*.iml
.vscode/
*.log

# ==========================================
# Backend (Java / Maven / Spring Boot)
# ==========================================
backend/target/
backend/*.jar
backend/*.war
backend/.mvn/wrapper/maven-wrapper.jar
backend/uploads/
backend/.flattened-pom.xml
backend/src/main/resources/application-local.yml
backend/.env
.env
*.local.yml

# ==========================================
# Frontend (Node.js / React / Vite)
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.env.local
frontend/.env.*.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
